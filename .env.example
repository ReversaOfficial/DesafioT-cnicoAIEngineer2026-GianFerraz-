# ---------------------------------------------------------------------------
# Empório da Música — configuração do agente
# Copie para `.env` e preencha. Nenhum valor aqui é secreto.
# ---------------------------------------------------------------------------

# Provedor do LLM: gemini | openai | anthropic | groq | openrouter | ollama
EMPORIO_LLM_PROVIDER=gemini

# Modelo. Defaults por provedor (usados quando a variável fica vazia):
#   gemini     -> gemini-2.5-flash
#   openai     -> gpt-4o-mini
#   anthropic  -> claude-sonnet-4-5
#   groq       -> llama-3.3-70b-versatile
#   openrouter -> google/gemini-2.5-flash
#   ollama     -> qwen2.5:7b-instruct
EMPORIO_LLM_MODEL=

# --- Chaves de API (preencha apenas a do provedor escolhido) ---------------
# Gemini (gratuito, sem cartão): https://aistudio.google.com/apikey
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Base URL própria (proxy, Azure, LiteLLM, vLLM...). Vazio = default do provedor.
EMPORIO_LLM_BASE_URL=

# --- Comportamento do agente ----------------------------------------------
EMPORIO_LLM_TEMPERATURE=0.3
EMPORIO_MAX_TOOL_ITERATIONS=6

# Data/hora de referência para cálculos de prazo (devolução, garantia, horário
# de funcionamento). Vazio = relógio real da máquina.
# Útil para reproduzir os exemplos de conversa do repositório.
# Formatos aceitos: 2026-03-20  ou  2026-03-20T14:30
EMPORIO_NOW=

# Log estruturado de cada turno (JSONL) em logs/turns.jsonl
EMPORIO_LOG_TURNS=1
