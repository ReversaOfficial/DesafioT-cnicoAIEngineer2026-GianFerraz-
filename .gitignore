# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Segredos — nunca versionar.
# O padrão é amplo de propósito: no Windows é comum o editor salvar o arquivo
# como `.env.txt`, que um `.gitignore` com apenas `.env` deixaria passar.
.env*
!.env.example
*.key
*.pem
secrets.*

# Artefatos gerados em runtime (reconstruiveis via `make build`)
var/
logs/
*.sqlite3
*.db

# Arquivos compactados originais (os CSVs extraidos estao em data/)
*.rar
*.zip

# Sistema operacional / editores
.DS_Store
Thumbs.db
.idea/
.vscode/
